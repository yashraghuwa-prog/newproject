```ejs
<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('./partials/head') %>
    <title>Homepage</title>
</head>

<body>

    <%- include('./partials/nav') %>

    <div class="container mt-3">

        <% blogs.forEach(blog => { %>

            <div class="card mb-3" style="width: 18rem;">

                <img
                    src="<%= blog.coverImageUrl %>"
                    class="card-img-top"
                    alt="<%= blog.title %>"
                >

                <div class="card-body">

                    <h5 class="card-title">
                        <%= blog.title %>
                    </h5>

                    <a
                        href="/blog/<%= blog._id %>"
                        class="btn btn-primary"
                    >
                        View Blog
                    </a>

                </div>

            </div>

        <% }) %>

    </div>

    <%- include('./partials/scripts') %>

</body>

</html>
```
